# Discord Bot Token from Developer Portal (Bot tab > Reset Token)
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE

# Command prefix for text commands (e.g. !help, !forward)
PREFIX=!

# Dedicated Source Server ID (🌅 🌴The Beach 🌊 🎋)
SOURCE_GUILD_ID=988844532185595964

# (Optional) Comma-separated list of Discord user IDs allowed to run forward commands.
# Leave blank to allow any server Administrator.
ALLOWED_USER_IDS=
